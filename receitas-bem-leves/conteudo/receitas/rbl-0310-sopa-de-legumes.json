  "preparo": [
    {
      "texto": "Numa panela grande, aqueça o azeite e refogue a cebola até ficar transparente. Junte o alho e o tomate e mexa por 2 minutos."
    },
    {
      "texto": "Acrescente a batata, a cenoura e o chuchu, refogue por 2 minutos e cubra com a água quente. Junte o sal."
    },
    {
      "texto": "Cozinhe com a panela semitampada por 15 minutos.",
      "temporizador_min": 15
    },
    {
      "texto": "Junte a vagem e a abobrinha e cozinhe mais 10 minutos, até todos os legumes ficarem macios.",
      "temporizador_min": 10
    },
    {
      "texto": "Tempere com a pimenta, acerte o sal e desligue. Espalhe a salsinha na hora de servir."
    }
