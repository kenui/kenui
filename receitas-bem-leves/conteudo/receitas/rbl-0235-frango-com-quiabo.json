    },
    {
      "texto": "Numa panela, aqueça o restante do óleo e doure o frango por 8 minutos, virando.",
      "temporizador_min": 8
    },
    {
      "texto": "Junte a cebola e o tomate e refogue 3 minutos.",
      "temporizador_min": 3
    },
    {
      "texto": "Acrescente a água, tampe e cozinhe em fogo baixo por 20 minutos, até o frango ficar macio.",
      "temporizador_min": 20
    },
    {
      "texto": "Junte o quiabo e o restante do sal e cozinhe mais 5 minutos sem tampa.",
      "temporizador_min": 5
    },
    {
      "texto": "Finalize com a cebolinha."
    }
