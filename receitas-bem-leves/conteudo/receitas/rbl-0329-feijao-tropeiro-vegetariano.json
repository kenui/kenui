  "preparo": [
    {
      "texto": "Numa panela larga, aqueça o azeite e refogue a cebola até dourar. Junte o alho e mexa por 1 minuto."
    },
    {
      "texto": "Abra um espaço no centro, quebre os ovos e mexa até ficarem cozidos. Misture com a cebola."
    },
    {
      "texto": "Junte a couve e refogue por 2 minutos, até murchar."
    },
    {
      "texto": "Acrescente o feijão, o sal e a pimenta e mexa por 3 minutos, até aquecer."
    },
    {
      "texto": "Junte a farinha aos poucos, mexendo, até o feijão ficar soltinho e úmido."
    },
    {
      "texto": "Desligue, misture a cebolinha e a salsinha e sirva."
    }
